# Abhyas is model-agnostic by design.
# Copy to .env and fill in what you have. With no keys, the deterministic
# mock engine runs the full loop (student + scorer) — same contracts, same code.

# --- Cloud LLM (student simulator + scorer) ---
# Any OpenAI-compatible endpoint (GLM, OpenAI, Together, vLLM, Ollama, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Or Anthropic (Claude) — the deck's reference model for the evaluator pass
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Indic speech (production path; V0 web demo uses browser speech APIs) ---
SARVAM_API_KEY=

# Server
PORT=8787

# --- Operations (see docs/10-ops-runbook.md) ---
# CORS allowlist, comma-separated. The server's own origin is always allowed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set behind a reverse proxy: true | 1 | IP/subnet list
TRUST_PROXY=
# debug | info | warn | error (structured JSON logs on stdout)
LOG_LEVEL=info
